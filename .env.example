NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/shyam_pnb
SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET
CSRF_SECRET=GENERATE_ANOTHER_LONG_RANDOM_SECRET
APP_ORIGIN=https://YOUR-DOMAIN.example
COOKIE_SECURE=true
SENSITIVE_DATA_KEY=GENERATE_64_HEX_CHARACTERS

# Private owner Admin settings — keep only on the server, never in client/public files.
ADMIN_USERNAME=YOUR_ADMIN_ID
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
ADMIN_DAILY_PIN=YOUR_ADMIN_PIN
PUBLIC_CONTACT=YOUR_PUBLIC_CONTACT
